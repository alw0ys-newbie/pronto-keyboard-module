#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer { // Layer 0
            
            // ||   |   |   |   |   ||       ||   |   |   |   |   ||
            // || A | Z | E | R | T ||       || Y | U | I | O | P ||
            // || Q | S | D | F | G ||       || H | J | K | L | M ||
            // || ↑ | W | X | C | V ||       || B | N | , | . | ^ ||
            //         || ctr | spc ||       || ent | alt ||


            bindings = <
               &to 0 &to 1 &to 2 &to 3 &kp DEL       &none &none &none &none &none
               &kp A &kp Z &kp E &kp R &kp T        &none &none &none &none &none
               &kp Q &kp S &kp D &kp F &kp G        &none &none &none &none &none
               &kp LSHFT &kp W &kp X &kp C &kp V    &none &none &none &none &none
                            &kp SPACE  &kp ENTER     &kp ENTER &kp LALT
            >;
        };

        end_letter_layer { //Layer 1
            bindings = <
               &to 0 &to 1 &to 2 &to 3 &kp DEL       &none &none &none &none &none
               &kp Y &kp U &kp I &kp O &kp P        &none &none &none &none &none
               &kp H &kp J &kp K &kp L &kp M        &none &none &none &none &none
               &kp B &kp N &none &none &none        &none &none &none &none &none
                            &kp ENTER &kp SPACE     &kp ENTER &kp LALT
            >;
        }

        number_layer { // Layer 2
            
            bindings = <
               &to 0 &to 1 &to 2 &to 3 &kp DEL        &none &none &none &none &none
               &kp N0 &kp N1 &kp N2 &kp N3 &none    &none &none &none &none &none
               &none  &kp N4 &kp N5 &kp N6 &none    &none &none &none &none &none
               &none &kp N7 &kp N8 &kp N9 &none     &none &none &none &none &none
                            &kp ENTER &kp SPACE     &kp ENTER &kp LALT
            >;
        };

        special_layer { // Layer 3
            
            bindings = <
               &to 0 &to 1 &to 2 &to 3 &kp DEL                             &none &none &none &none &none
               &kp C_BRI_DN  &kp C_BRI_UP &kp UP &none &none           &none &none &none &none &none
               &kp C_VOL_UP2  &kp LEFT &kp DOWN &kp RIGHT &none           &none &none &none &none &none
               &kp C_VOL_DN &none &none &none &none                     &none &none &none &none &none
                            &kp ENTER &kp SPACE                            &kp ENTER &kp LALT
            >;
        };
    };
 };
