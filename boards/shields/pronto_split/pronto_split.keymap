#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer { // Layer 0
            
            // ||   |   |   |   |   ||       ||   |   |   |   |   ||
            // || A | Z | E | R | T ||       || Y | U | I | O | P ||
            // || Q | S | D | F | G ||       || H | J | K | L | M ||
            // || ↑ | W | X | C | V ||       || B | N | , | . | ^ ||
            //         || ctr | spc ||       || ent | alt ||


            bindings = <
               &to 0 &to 1 &none &none &none        &none &none &none &none &none
               &kp A &kp Z &kp E &kp R &kp T        &kp Y &kp U &kp I &kp O &kp P
               &kp Q &kp S &kp D &kp F &kp G        &kp H &kp J &kp K &kp L &kp M
               &kp LSHFT &kp W &kp X &kp C &kp V    &kp B &kp N &kp , &kp . &kp !
                            &kp LCTRL &kp SPACE     &kp ENTER &kp LALT
            >;
        };

        number_layer { // Layer 1
            
            bindings = <
               &to 0 &to 1 &none &none &none        &none &none &none &none &none
               &kp N0 &kp N1 &kp N2 &kp N3 &none         &kp Y &kp U &kp I &kp O &kp P
               &none  &kp N4 &kp N5 &kp N6 &none        &kp H &kp J &kp K &kp L &kp M
               &none &kp N7 &kp N8 &kp N9 &none     &kp B &kp N &kp , &kp . &kp !
                            &kp LCTRL &kp SPACE     &kp ENTER &kp LALT
            >;
        };
    };
 };
