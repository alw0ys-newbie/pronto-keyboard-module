#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer { // Layer 0
            // -------------------------------------
            // ||     A     |    Z    ||          ||     1     |    2    ||
            // ||    E      |    R    ||          ||     3     |    4    ||


            bindings = <
                &kp A   &kp Z       &kp 1   &kp 2 
                &kp E   &kp R       &kp 3   &kp 4
            >;
        };
    };
 };
